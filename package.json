{
  "name": "linguaku",
  "version": "1.10.1",
  "private": true,
  "type": "module",
  "description": "Offline-first PWA teaching English and Japanese to Indonesian speakers.",
  "license": "MIT",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check:licenses": "node scripts/check-licenses.mjs",
    "icons": "node scripts/gen-icons.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run check:licenses && npm run check:audio && npm run build && npm run check:bundle && npm run check:offline",
    "ingest:fetch": "node scripts/ingest/fetch.ts",
    "ingest:en": "node scripts/ingest/build-en.ts",
    "ingest:contrastive": "node scripts/ingest/build-contrastive.ts",
    "ingest:ja": "node --max-old-space-size=6144 scripts/ingest/build-ja.ts",
    "check:audio": "node scripts/check-audio.mjs",
    "ingest:audio": "node scripts/ingest/build-audio.ts",
    "ingest:fetch:wiki": "node scripts/ingest/fetch-wikimedia.ts",
    "ingest:glosses": "node scripts/ingest/build-glosses.ts",
    "ingest:chunks": "node scripts/ingest/build-chunks.ts",
    "ingest:topics": "node scripts/ingest/build-topics.ts",
    "check:offline": "node scripts/check-offline.mjs"
  },
  "dependencies": {
    "dexie": "^4.4.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ts-fsrs": "^5.4.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@sglkc/kuromoji": "^1.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "fast-xml-parser": "^5.10.1",
    "globals": "^17.9.0",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "yaml": "^2.9.0"
  }
}
