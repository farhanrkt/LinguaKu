{"sources":["linguaku-authored","tatoeba"],"license":"CC BY-SA 4.0","lang":"ja","band":2,"count":6,"chunks":[{"id":"ja:chunk:いただきます","headword":"いただきます","gloss":"(ucapan sebelum makan)","note":"Tidak ada padanannya. Bukan doa — ini ucapan terima kasih atas makanannya, dan selalu diucapkan.","freqRank":750,"band":2,"anchors":["tatoeba:jpn:917967","tatoeba:jpn:150125"]},{"id":"ja:chunk:おはようございます","headword":"おはようございます","gloss":"selamat pagi (sopan)","freqRank":750,"band":2,"anchors":["tatoeba:jpn:1576172","tatoeba:jpn:335372","tatoeba:jpn:184996","tatoeba:jpn:778267"]},{"id":"ja:chunk:お世話になります","headword":"お世話になります","gloss":"terima kasih atas bantuannya","note":"§2.5 menyebut frasa ini sebagai contoh. Artinya kira-kira \"saya berutang budi pada Anda\" dan dipakai sebagai sapaan biasa di dunia kerja.","freqRank":750,"band":2,"anchors":["tatoeba:jpn:226997","tatoeba:jpn:226998"]},{"id":"ja:chunk:こんにちは","headword":"こんにちは","gloss":"selamat siang, halo","freqRank":750,"band":2,"anchors":["tatoeba:jpn:1680679","tatoeba:jpn:217296","tatoeba:jpn:3069988","tatoeba:jpn:3480287"]},{"id":"ja:chunk:もう一度","headword":"もう一度","gloss":"sekali lagi","freqRank":750,"band":2,"anchors":["tatoeba:jpn:1034968","tatoeba:jpn:10979916","tatoeba:jpn:13894320","tatoeba:jpn:187849"]},{"id":"ja:chunk:よろしくお願いします","headword":"よろしくお願いします","gloss":"mohon kerja samanya","note":"Diucapkan saat berkenalan, saat memulai kerja sama, dan di akhir permintaan. Tidak ada terjemahan tunggalnya.","freqRank":750,"band":2,"anchors":["tatoeba:jpn:2662183","tatoeba:jpn:369495","tatoeba:jpn:806267","tatoeba:jpn:217288"]}]}