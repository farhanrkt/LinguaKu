{"sources":["linguaku-authored","tatoeba"],"license":"CC BY-SA 4.0","lang":"ja","band":6,"count":23,"chunks":[{"id":"ja:chunk:ありがとうございます","headword":"ありがとうございます","gloss":"terima kasih (sopan)","band":6,"anchors":["tatoeba:jpn:4971","tatoeba:jpn:8565446","tatoeba:jpn:9559301","tatoeba:jpn:146045"]},{"id":"ja:chunk:いただきます","headword":"いただきます","gloss":"(ucapan sebelum makan)","note":"Tidak ada padanannya. Bukan doa — ini ucapan terima kasih atas makanannya, dan selalu diucapkan.","band":6,"anchors":["tatoeba:jpn:917967","tatoeba:jpn:150125"]},{"id":"ja:chunk:おはようございます","headword":"おはようございます","gloss":"selamat pagi (sopan)","band":6,"anchors":["tatoeba:jpn:335372","tatoeba:jpn:1576172","tatoeba:jpn:184996","tatoeba:jpn:778267"]},{"id":"ja:chunk:おやすみなさい","headword":"おやすみなさい","gloss":"selamat tidur","band":6,"anchors":["tatoeba:jpn:98982","tatoeba:jpn:227480","tatoeba:jpn:426899"]},{"id":"ja:chunk:お世話になります","headword":"お世話になります","gloss":"terima kasih atas bantuannya","note":"§2.5 menyebut frasa ini sebagai contoh. Artinya kira-kira \"saya berutang budi pada Anda\" dan dipakai sebagai sapaan biasa di dunia kerja.","band":6,"anchors":["tatoeba:jpn:226997","tatoeba:jpn:226998"]},{"id":"ja:chunk:お元気ですか","headword":"お元気ですか","gloss":"apa kabar","band":6,"anchors":["tatoeba:jpn:217191","tatoeba:jpn:400933","tatoeba:jpn:4260196","tatoeba:jpn:400865"]},{"id":"ja:chunk:お名前は","headword":"お名前は","gloss":"siapa namanya","band":6,"anchors":["tatoeba:jpn:226572","tatoeba:jpn:233570","tatoeba:jpn:408292","tatoeba:jpn:10336864"]},{"id":"ja:chunk:こんにちは","headword":"こんにちは","gloss":"selamat siang, halo","band":6,"anchors":["tatoeba:jpn:217296","tatoeba:jpn:373351","tatoeba:jpn:400865","tatoeba:jpn:538094"]},{"id":"ja:chunk:こんばんは","headword":"こんばんは","gloss":"selamat malam (saat bertemu)","band":6,"anchors":["tatoeba:jpn:426900","tatoeba:jpn:9453923"]},{"id":"ja:chunk:ごちそうさまでした","headword":"ごちそうさまでした","gloss":"(ucapan setelah makan)","band":6,"anchors":["tatoeba:jpn:10908793"]},{"id":"ja:chunk:ごめんなさい","headword":"ごめんなさい","gloss":"maaf","note":"Lebih personal daripada すみません, dan tidak dipakai untuk memanggil pelayan.","band":6,"anchors":["tatoeba:jpn:126740","tatoeba:jpn:219058","tatoeba:jpn:808701","tatoeba:jpn:1556117"]},{"id":"ja:chunk:さようなら","headword":"さようなら","gloss":"selamat tinggal","band":6,"anchors":["tatoeba:jpn:216703","tatoeba:jpn:426889","tatoeba:jpn:640569"]},{"id":"ja:chunk:しかたがない","headword":"しかたがない","gloss":"mau bagaimana lagi","band":6,"anchors":["tatoeba:jpn:94884","tatoeba:jpn:170301"]},{"id":"ja:chunk:すみません","headword":"すみません","gloss":"permisi; maaf","note":"Satu kata untuk tiga hal — memanggil orang, minta maaf, dan berterima kasih halus. Konteksnya yang menentukan.","band":6,"anchors":["tatoeba:jpn:185391","tatoeba:jpn:214132","tatoeba:jpn:214152","tatoeba:jpn:214156"]},{"id":"ja:chunk:そうですね","headword":"そうですね","gloss":"iya ya, benar juga","note":"Sering hanya pengisi jeda sambil berpikir, bukan persetujuan penuh.","band":6,"anchors":["tatoeba:jpn:171820","tatoeba:jpn:232414","tatoeba:jpn:189750","tatoeba:jpn:1039972"]},{"id":"ja:chunk:ちょっと待ってください","headword":"ちょっと待ってください","gloss":"tunggu sebentar","band":6,"anchors":["tatoeba:jpn:10901614"]},{"id":"ja:chunk:どういたしまして","headword":"どういたしまして","gloss":"sama-sama","band":6,"anchors":["tatoeba:jpn:4929","tatoeba:jpn:5278","tatoeba:jpn:408295","tatoeba:jpn:4705664"]},{"id":"ja:chunk:はじめまして","headword":"はじめまして","gloss":"salam kenal","band":6,"anchors":["tatoeba:jpn:4584858","tatoeba:jpn:9699149"]},{"id":"ja:chunk:もう一度","headword":"もう一度","gloss":"sekali lagi","band":6,"anchors":["tatoeba:jpn:187849","tatoeba:jpn:194299","tatoeba:jpn:194313","tatoeba:jpn:212237"]},{"id":"ja:chunk:よろしくお願いします","headword":"よろしくお願いします","gloss":"mohon kerja samanya","note":"Diucapkan saat berkenalan, saat memulai kerja sama, dan di akhir permintaan. Tidak ada terjemahan tunggalnya.","band":6,"anchors":["tatoeba:jpn:369495","tatoeba:jpn:806267","tatoeba:jpn:2662183","tatoeba:jpn:217288"]},{"id":"ja:chunk:わかりました","headword":"わかりました","gloss":"saya mengerti, baik","band":6,"anchors":["tatoeba:jpn:5955914","tatoeba:jpn:10308591"]},{"id":"ja:chunk:わかりません","headword":"わかりません","gloss":"saya tidak mengerti","band":6,"anchors":["tatoeba:jpn:121070","tatoeba:jpn:158350","tatoeba:jpn:159353","tatoeba:jpn:187619"]},{"id":"ja:chunk:大丈夫です","headword":"大丈夫です","gloss":"tidak apa-apa; saya baik-baik saja","band":6,"anchors":["tatoeba:jpn:137492","tatoeba:jpn:137493","tatoeba:jpn:155194","tatoeba:jpn:214360"]}]}