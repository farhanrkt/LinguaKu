{"sources":["linguaku-authored","tatoeba"],"license":"CC BY 2.0 FR","lang":"en","band":1,"count":47,"chunks":[{"id":"en:chunk:how_are_you","headword":"how are you","gloss":"apa kabar","freqRank":53,"band":1,"anchors":["tatoeba:eng:373320","tatoeba:eng:37437"],"examples":[{"id":"tatoeba:eng:373320","text":"How are you?","difficulty":0.2821,"maxRank":53,"tr":{"id":"tatoeba:ind:365986","text":"Apa kabar?"}},{"id":"tatoeba:eng:37437","text":"How are you, Tom?","difficulty":0.3234,"maxRank":53,"tr":{"id":"tatoeba:ind:4790503","text":"Apa kabar, Tom?"}}]},{"id":"en:chunk:get_in","headword":"get in","gloss":"masuk (ke mobil, taksi)","freqRank":70,"band":1,"anchors":["tatoeba:eng:2091170","tatoeba:eng:326251"],"examples":[{"id":"tatoeba:eng:2091170","text":"No one can get in or out.","difficulty":0.3663,"maxRank":120,"tr":{"id":"tatoeba:ind:13683541","text":"Tidak ada yang bisa masuk atau keluar."}},{"id":"tatoeba:eng:326251","text":"The train got in on time.","difficulty":0.4434,"maxRank":450,"tr":{"id":"tatoeba:ind:4733154","text":"Keretanya datang tepat waktu."}}]},{"id":"en:chunk:get_on","headword":"get on","gloss":"naik (bus, kereta, pesawat)","note":"Kendaraan yang bisa dimasuki sambil berdiri pakai get on; mobil dan taksi pakai get in.","freqRank":70,"band":1,"anchors":["tatoeba:eng:6704080","tatoeba:eng:73122"],"examples":[{"id":"tatoeba:eng:6704080","text":"We got on the wrong train.","difficulty":0.4434,"maxRank":450,"tr":{"id":"tatoeba:ind:11324595","text":"Kita naik kereta yang salah."}},{"id":"tatoeba:eng:73122","text":"Get on the bus one by one.","difficulty":0.4492,"maxRank":435,"tr":{"id":"tatoeba:ind:10200343","text":"Naiklah bus satu per satu."}}]},{"id":"en:chunk:get_out_of","headword":"get out of","gloss":"keluar dari","freqRank":70,"band":1,"anchors":["tatoeba:eng:1852279","tatoeba:eng:5852505"],"examples":[{"id":"tatoeba:eng:1852279","text":"Get out of here now!","difficulty":0.3373,"maxRank":98,"tr":{"id":"tatoeba:ind:11484766","text":"Pergi dari sini