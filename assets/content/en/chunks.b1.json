":1,"anchors":["tatoeba:eng:22283","tatoeba:eng:2644075"],"examples":[{"id":"tatoeba:eng:22283","text":"We're on our way home.","difficulty":0.377,"maxRank":182,"tr":{"id":"tatoeba:ind:4398769","text":"Kami sedang berada dalam perjalanan pulang."}},{"id":"tatoeba:eng:2644075","text":"Tell Tom Mary's on the way.","difficulty":0.4226,"maxRank":326,"tr":{"id":"tatoeba:ind:8873544","text":"Beri tahu Tom bahwa Mary sedang dalam perjalanan."}}]},{"id":"en:chunk:a_lot_of","headword":"a lot of","gloss":"banyak","freqRank":139,"band":1,"anchors":["tatoeba:eng:11862718","tatoeba:eng:301274"],"examples":[{"id":"tatoeba:eng:11862718","text":"We made a lot of money.","difficulty":0.3726,"maxRank":150,"tr":{"id":"tatoeba:ind:11872010","text":"Kita menghasilkan banyak uang."}},{"id":"tatoeba:eng:301274","text":"He got a lot of money.","difficulty":0.3726,"maxRank":150,"tr":{"id":"tatoeba:ind:5087819","text":"Dia punya banyak uang."}}]},{"id":"en:chunk:right_now","headword":"right now","gloss":"sekarang juga","freqRank":141,"band":1,"anchors":["tatoeba:eng:241642","tatoeba:eng:2007677"],"examples":[{"id":"tatoeba:eng:241642","text":"Do it right now!","difficulty":0.3526,"maxRank":141,"tr":{"id":"tatoeba:ind:336227","text":"Lakukan, tapi sekarang !"}},{"id":"tatoeba:eng:2007677","text":"Let's do it right now.","difficulty":0.3913,"maxRank":227,"tr":{"id":"tatoeba:ind:4715592","text":"Mari kita lakukan sekarang juga."}}]},{"id":"en:chunk:make_money","headword":"make money","gloss":"menghasilkan uang","freqRank":150,"band":1,"anchors":["tatoeba:eng:11721363","tatoeba:eng:6066934"],"examples":[{"id":"tatoeba:eng:11721363","text":"If you want to make money, study English; but if you want to have friends, learn Esperanto.","difficulty":0.6422,"maxRank":1157,"tr":{"id":"tatoeba:ind:12838664","text":"Jika ingin mendapatkan uang, belajarlah bahasa Inggris; tetapi jika ingin mendapatkan teman, belajarlah bahasa Esperanto."}},{"id":"tatoeba:eng:6066934","text":"Does your website make you money?","difficulty":0.5336,"maxRank":1819,"tr":{"id":"tatoeba:ind:11282553","text":"Apakah situs webmu menghasilkan uang?"}}]},{"id":"en:chunk:get_off","headword":"get off","gloss":"turun (dari bus, kereta)","freqRank":155,"band":1,"anchors":["tatoeba:eng:1696829","tatoeba:eng:258191"],"examples":[{"id":"tatoeba:eng:1696829","text":"What time do you get off?","difficulty":0.3747,"maxRank":155,"tr":{"id":"tatoeba:ind:5032926","text":"Kamu berangkat jam berapa?"}},{"id":"tatoeba:eng:258191","text":"I'm getting off at the next stop.","difficulty":0.4304,"maxRank":325,"tr":{"id":"tatoeba:ind:3326999","text":"Saya turun di halte berikutnya."}}]},{"id":"en:chunk:take_off","headword":"take off","gloss":"melepas (baju); lepas landas (pesawat)","freqRank":155,"band":1,"anchors":["tatoeba:eng:11881528","tatoeba:eng:311482"],"examples":[{"id":"tatoeba:eng:11881528","text":"He took it off.","difficulty":0.377,"maxRank":206,"tr":{"id":"tatoeba:ind:4239227","text":"Dia menanggalkannya."}},{"id":"tatoeba:eng:311482","text":"She took it off.","difficulty":0.377,"maxRank":206,"tr":{"id":"tatoeba:ind:4239227","text":"Dia menanggalkannya."}}]},{"id":"en:chunk:how_long_does_it_take","headword":"how long does it take","gloss":"berapa lama waktunya","note":"Kata kerjanya take. Waktu \"diambil\", bukan \"dipakai\" seperti terjemahan harfiahnya.","freqRank":159,"band":1,"anchors":["tatoeba:eng:36829","tatoeba:eng:26028"],"examples":[{"id":"tatoeba:eng:36829","text":"How long does it take?","difficulty":0.3683,"maxRank":159,"tr":{"id":"tatoeba:ind:3369267","text":"Butuh waktu berapa lama?"}},{"id":"tatoeba:eng:26028","text":"How long does it take to the train station by taxi?","difficulty":0.5173,"maxRank":1554,"tr":{"id":"tatoeba:ind:3864828","text":"Berapa lama menuju stasiun dengan taksi?"}}]},{"id":"en:chunk:make_sure","headword":"make sure","gloss":"memastikan","freqRank":172,"band":1,"anchors":["tatoeba:eng:3024077","tatoeba:eng:2984455"],"examples":[{"id":"tatoeba:eng:3024077","text":"Make sure you don't hurt yourself.","difficulty":0.4428,"maxRank":446,"tr":{"id":"tatoeba:ind:3942781","text":"Pastikan kamu tidak melukai dirimu sendiri."}},{"id":"tatoeba:eng:2984455","text":"\"Can you give this to Tom? It's very important.\" \"I'll make sure he gets it.\"","difficulty":0.5151,"maxRank":602,"tr":{"id":"tatoeba:ind:8864880","text":"\"Bisakah kamu memberikan ini kepada Tom? Ini sangat penting.\" \"Akan kupastikan dia mendapatkannya.\""}}]},{"id":"en:chunk:I'd_like_to","headword":"I'd like to","gloss":"saya ingin","note":"Lebih sopan daripada \"I want to\", dan inilah bentuk yang dipakai di toko, restoran, atau ke orang yang belum dikenal.","freqRank":178,"band":1,"anchors":["tatoeba:eng:261169","tatoeba:eng:1936431"],"examples":[{"id":"tatoeba:eng:261169","text":"I'd like to see her.","difficulty":0.3756,"maxRank":178,"tr":{"id":"tatoeba:ind:5196278","text":"Aku ingin bertemu dengannya."}},{"id":"tatoeba:eng:1936431","text":"I'd like to know for sure.","difficulty":0.3836,"maxRank":178,"tr":{"id":"tatoeba:ind:3956501","text":"Aku ingin tahu secara pasti."}}]},{"id":"en:chunk:find_out","headword":"find out","gloss":"mencari tahu","freqRank":179,"band":1,"anchors":["tatoeba:eng:2387600","tatoeba:eng:4013924"],"examples":[{"id":"tatoeba:eng:2387600","text":"I need to find out what to do.","difficulty":0.4,"maxRank":179,"tr":{"id":"tatoeba:ind:4270667","text":"Aku perlu mengetahui apa yang harus dilakukan?"}},{"id":"tatoeba:eng:4013924","text":"Let me see what I can find out.","difficulty":0.4,"maxRank":179,"tr":{"id":"tatoeba:ind:5239357","text":"Mari lihat apa yang bisa kutemukan."}}]},{"id":"en:chunk:look_after","headword":"look after","gloss":"menjaga, mengasuh","freqRank":185,"band":1,"anchors":["tatoeba:eng:23302","tatoeba:eng:276240"],"examples":[{"id":"tatoeba:eng:23302","text":"We should look after our parents.","difficulty":0.4545,"maxRank":319,"tr":{"id":"tatoeba:ind:4398848","text":"Kita harus memperhatikan kedua orang tua kita."}},{"id":"tatoeba:eng:276240","text":"Who will look after the baby?","difficulty":0.537,"maxRank":683,"tr":{"id":"tatoeba:ind:4552703","text":"Siapa yang akan menjaga bayinya?"}}]},{"id":"en:chunk:look_at","headword":"look at","gloss":"melihat, memandang","freqRank":185,"band":1,"anchors":["tatoeba:eng:1934863","tatoeba:eng:2235864"],"examples":[{"id":"tatoeba:eng:1934863","text":"Look at this!","difficulty":0.3621,"maxRank":185,"tr":{"id":"tatoeba:ind:4717519","text":"Lihat ini!"}},{"id":"tatoeba:eng:2235864","text":"Look at Tom.","difficulty":0.3621,"maxRank":185,"tr":{"id":"tatoeba:ind:3955869","text":"Lihatlah ke arah Tom."}}]},{"id":"en:chunk:look_for","headword":"look for","gloss":"mencari","note":"Cari itu look for; look at itu melihat. Satu kata di bahasa kita, dua arah di sana.","freqRank":185,"band":1,"anchors":["tatoeba:eng:12249027","tatoeba:eng:3001263"],"examples":[{"id":"tatoeba:eng:12249027","text":"They're looking for us.","difficulty":0.3944,"maxRank":270,"tr":{"id":"tatoeba:ind:13777200","text":"Mereka mencari kita."}},{"id":"tatoeba:eng:3001263","text":"We're looking for Tom.","difficulty":0.3944,"maxRank":270,"tr":{"id":"tatoeba:ind:11467362","text":"Kami sedang mencari Tom."}}]},{"id":"en:chunk:take_a_look","headword":"take a look","gloss":"melihat sebentar","freqRank":185,"band":1,"anchors":["tatoeba:eng:373278","tatoeba:eng:3408767"],"examples":[{"id":"tatoeba:eng:373278","text":"Let's take a look.","difficulty":0.3833,"maxRank":227,"tr":{"id":"tatoeba:ind:4713460","text":"Mari kita coba lihat."}},{"id":"tatoeba:eng:3408767","text":"Take a look at these.","difficulty":0.3881,"maxRank":216,"tr":{"id":"tatoeba:ind:10807104","text":"Lihat ini."}}]},{"id":"en:chunk:give_up","headword":"give up","gloss":"menyerah","freqRank":190,"band":1,"anchors":["tatoeba:eng:1841194","tatoeba:eng:241200"],"examples":[{"id":"tatoeba:eng:1841194","text":"Don't give up.","difficulty":0.3638,"maxRank":190,"tr":{"id":"tatoeba:ind:11901155","text":"Jangan menyerah."}},{"id":"tatoeba:eng:241200","text":"I give up.","difficulty":0.3638,"maxRank":190,"tr":{"id":"tatoeba:ind:11211337","text":"Aku menyerah."}}]},{"id":"en:chunk:put_on","headword":"put on","gloss":"memakai (baju, sepatu)","freqRank":194,"band":1,"anchors":["tatoeba:eng:2891819","tatoeba:eng:18092"],"examples":[{"id":"tatoeba:eng:2891819","text":"Put on some music.","difficulty":0.4305,"maxRank":472,"tr":{"id":"tatoeba:ind:4070438","text":"Putarlah musik."}},{"id":"tatoeba:eng:18092","text":"Please put on your shoes.","difficulty":0.46,"maxRank":659,"tr":{"id":"tatoeba:ind:4346894","text":"Tolong kenakan sepatu Anda."}}]},{"id":"en:chunk:feel_like","headword":"feel like","gloss":"ingin, kepingin","note":"\"feel like\" + kegiatan berarti ingin melakukannya, bukan \"merasa seperti\".","freqRank":237,"band":1,"anchors":["tatoeba:eng:21854","tatoeba:eng:2275993"],"examples":[{"id":"tatoeba:eng:21854","text":"I don't feel like going out.","difficulty":0.402,"maxRank":237,"tr":{"id":"tatoeba:ind:4390663","text":"Aku sedang malas pergi keluar."}},{"id":"tatoeba:eng:2275993","text":"I don't feel like talking.","difficulty":0.4163,"maxRank":335,"tr":{"id":"tatoeba:ind:10319747","text":"Aku sedang tidak ingin berbicara."}}]},{"id":"en:chunk:at_the_same_time","headword":"at the same time","gloss":"pada saat yang sama","freqRank":253,"band":1,"anchors":["tatoeba:eng:13680608","tatoeba:eng:11538791"],"examples":[{"id":"tatoeba:eng:13680608","text":"I'm doing two things at the same time.","difficulty":0.4222,"maxRank":253,"tr":{"id":"tatoeba:ind:13242057","text":"Aku melakukan dua hal bersamaan."}},{"id":"tatoeba:eng:11538791","text":"We can't think two things at the same time.","difficulty":0.4302,"maxRank":253,"tr":{"id":"tatoeba:ind:13694537","text":"Kita tidak bisa memikirkan dua hal bersamaan."}}]},{"id":"en:chunk:work_hard","headword":"work hard","gloss":"bekerja keras","freqRank":259,"band":1,"anchors":["tatoeba:eng:4603859","tatoeba:eng:4603854"],"examples":[{"id":"tatoeba:eng:4603859",